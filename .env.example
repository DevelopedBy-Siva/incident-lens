# Local PostgreSQL container
POSTGRES_DB=incidentlens
POSTGRES_USER=incidentlens
POSTGRES_PASSWORD=incidentlens
POSTGRES_PORT=5432
DATABASE_URL=postgresql://incidentlens:incidentlens@localhost:5432/incidentlens

# Datadog Logs Search
# DD_API_KEY is also accepted as the log API key when this value is empty.
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com
DATADOG_QUERY=status:(error OR warn OR critical)
DATADOG_LOOKBACK_SECONDS=30
DATADOG_ENVIRONMENT=prod
DATADOG_SERVICE=
POLL_INTERVAL=30

# Datadog LLM Observability
# Start Python with: ddtrace-run <your application command>
# Keep the real API key in .env or your deployment secret manager.
DD_API_KEY=
DD_SITE=datadoghq.com
DD_LLMOBS_ENABLED=1
DD_LLMOBS_AGENTLESS_ENABLED=1
DD_LLMOBS_ML_APP=incident-lens
DD_TRACE_ENABLED=1
DD_SERVICE=incident-lens
DD_ENV=development

# Application
# Generate a production value with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret
RESET_DATA_ON_STARTUP=false
CORS_ORIGINS=http://localhost:3000
DASHBOARD_URL=http://localhost:3000

# Local AI runtime
MODEL_PROVIDER=local
BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
DEVICE=cpu
DTYPE=auto
HF_TOKEN=
ARTIFACT_STORAGE_PATH=artifacts
DATASET_STORAGE_PATH=datasets

# LoRA training defaults
LORA_RANK=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
LORA_EPOCHS=1
LORA_LEARNING_RATE=0.0001
LORA_BATCH_SIZE=1
LORA_GRADIENT_ACCUMULATION_STEPS=1
LORA_MAX_SEQUENCE_LENGTH=1024
LORA_VALIDATION_FRACTION=0.1
LORA_SEED=42
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# Local services and frontend build configuration
LOG_SERVER_URL=http://localhost:5001
LOG_SERVICE_NAME=log-server
REACT_APP_API_URL=http://localhost:8000
REACT_APP_TEST_LOG_SERVER_URL=http://localhost:5001

# Optional notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
