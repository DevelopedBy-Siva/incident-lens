# Local PostgreSQL container
POSTGRES_DB=incidentlens
POSTGRES_USER=incidentlens
POSTGRES_PASSWORD=incidentlens
POSTGRES_PORT=5432
DATABASE_URL=postgresql://incidentlens:incidentlens@localhost:5432/incidentlens

# Analyzer polling cadence
# Analyzer Datadog credentials, site, query, and service are saved per project.
DATADOG_LOOKBACK_SECONDS=30
POLL_INTERVAL=30

# Datadog LLM Observability
# Start Python with: ddtrace-run <your application command>
# Keep the real API key in .env or your deployment secret manager.
DD_API_KEY=
DD_SITE=datadoghq.com
DD_LLMOBS_ENABLED=1
DD_LLMOBS_AGENTLESS_ENABLED=1
DD_LLMOBS_ML_APP=incident-lens
DD_TRACE_ENABLED=1
DD_SERVICE=incident-lens
DD_ENV=development

# Application
APP_ENV=development
# Generate a production value with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret
RESET_DATA_ON_STARTUP=false
CORS_ORIGINS=http://localhost:3000
DASHBOARD_URL=http://localhost:3000

# Local AI runtime
MODEL_PROVIDER=local
BASE_MODEL=Qwen/Qwen3.5-4B
DEVICE=cpu
DTYPE=auto
HF_TOKEN=
ARTIFACT_STORAGE_PATH=artifacts
DATASET_STORAGE_PATH=datasets

# Durable S3 storage (selected automatically whenever S3_BUCKET is set)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_DATASET_PREFIX=datasets
S3_ARTIFACT_PREFIX=artifacts

# LoRA training defaults
LORA_RANK=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
LORA_EPOCHS=1
LORA_LEARNING_RATE=0.0001
LORA_BATCH_SIZE=1
LORA_GRADIENT_ACCUMULATION_STEPS=1
LORA_MAX_SEQUENCE_LENGTH=1024
LORA_VALIDATION_FRACTION=0.1
LORA_SEED=42
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,in_proj_qkv,in_proj_z,in_proj_b,in_proj_a,out_proj,gate_proj,up_proj,down_proj

# EC2 GPU Training Configuration (optional)
# Set TRAINING_EC2_ENABLED=true to use temporary GPU instances instead of local training
# Requires AWS credentials with EC2 and S3 permissions
TRAINING_EC2_ENABLED=false
TRAINING_EC2_AMI_ID=
TRAINING_EC2_INSTANCE_TYPE=g6.xlarge
TRAINING_EC2_IAM_INSTANCE_PROFILE=
TRAINING_EC2_SUBNET_ID=
TRAINING_EC2_SECURITY_GROUP_IDS=
TRAINING_EC2_MAX_WAIT_SECONDS=3600
TRAINING_EC2_DETAILED_MONITORING=false
TRAINING_EC2_TERMINATE_ON_COMPLETION=true
TRAINING_EC2_ASSOCIATE_PUBLIC_IP=false

# Git Repository Configuration for EC2 Training
# Repository URL to clone on training instances (defaults to public GitHub repo)
GIT_REPOSITORY_URL=https://github.com/DevelopedBy-Siva/incident-lens.git
# Git commit SHA to checkout (auto-detected from deployment if not set)
GIT_COMMIT_SHA=

LOG_SERVER_URL=http://localhost:5001
REACT_APP_API_URL=http://localhost:8000

# Optional notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
